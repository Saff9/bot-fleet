# ─── Required ───────────────────────────────────────────────────────────
# Admin password for the login page (pick a strong one!)
BOT_FLEET_ADMIN_PASSWORD=change-me-to-a-strong-password

# 32-byte hex key for AES-256-GCM env-var encryption
# Generate with: openssl rand -hex 32
BOT_FLEET_MASTER_KEY=replace-with-openssl-rand-hex-32

# 32-byte hex key for HMAC-SHA256 cookie signing
# Generate with: openssl rand -hex 32
BOT_FLEET_SESSION_SECRET=replace-with-openssl-rand-hex-32

# ─── Database ────────────────────────────────────────────────────────────
# SQLite path. In Docker/Railway/Render, mount a volume at /data so this
# persists across restarts.
DATABASE_URL=file:/data/bots.db

# ─── Optional ────────────────────────────────────────────────────────────
# GitHub personal access token — only needed if cloning PRIVATE repos
# Create at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# Node env (auto-set by Railway/Render, but explicit for local dev)
NODE_ENV=development
